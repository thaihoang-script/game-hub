local function makeButton(text, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -8, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(25, 32, 55)
    button.TextColor3 = Color3.fromRGB(235, 240, 255)
    button.TextSize = 14
    button.Font = Enum.Font.Gotham
    button.Text = text
    button.Parent = body
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    button.MouseButton1Click:Connect(callback)
    return button
end

local function makeLabel(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -8, 0, 28)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(165, 175, 205)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.Text = text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = body
    return label
end

local function makeSlider(title, minValue, maxValue, initial, callback)
    makeLabel(title .. ": " .. initial)

    local slider = Instance.new("TextButton")
    slider.Size = UDim2.new(1, -8, 0, 34)
    slider.BackgroundColor3 = Color3.fromRGB(38, 35, 70)
    slider.TextColor3 = Color3.new(1, 1, 1)
    slider.Font = Enum.Font.Gotham
    slider.TextSize = 13
    slider.Text = "Bam de giam / bam de tang"
    slider.Parent = body
    Instance.new("UICorner", slider).CornerRadius = UDim.new(0, 7)

    local value = initial
    slider.MouseButton1Click:Connect(function()
        if value >= maxValue then
            value = minValue
        else
            value = math.min(value + 5, maxValue)
        end
        slider.Text = title .. ": " .. value
        callback(value)
    end)

    callback(initial)
end

local walkSpeed = 16
local jumpPower = 50
local espEnabled = false
local highlights = {}

local function applyMovement()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = walkSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = jumpPower
    end
end

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    applyMovement()
end)

local function clearESP()
    for target, highlight in pairs(highlights) do
        if highlight then highlight:Destroy() end
        highlights[target] = nil
    end
end

local function updateESP()
    clearESP()
    if not espEnabled then return end

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player and target.Character then
            local highlight = Instance.new("Highlight")
            highlight.Name = "NeonHubTestESP"
            highlight.FillColor = Color3.fromRGB(130, 70, 255)
            highlight.OutlineColor = Color3.fromRGB(0, 255, 190)
            highlight.FillTransparency = 0.65
            highlight.Adornee = target.Character
            highlight.Parent = gui
            highlights[target] = highlight
        end
    end
end

makeLabel("MOVEMENT")
makeSlider("Walk Speed", 16, 100, 16, function(value)
    walkSpeed = value
    applyMovement()
end)

makeSlider("Jump Power", 50, 150, 50, function(value)
    jumpPower = value
    applyMovement()
end)

makeLabel("VISUALS")
makeButton("ESP: OFF", function(button)
    -- handled below
end).Visible = false

local espButton
espButton = makeButton("ESP: OFF", function()
    espEnabled = not espEnabled
    espButton.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    updateESP()
end)

Players.PlayerAdded:Connect(function()
    task.wait(1)
    updateESP()
end)

Players.PlayerRemoving:Connect(function(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end)

makeLabel("AIM TRAINING")
makeButton("Aim Training: thong tin", function()
    print("Hay tao bia tap ngắm trong game Roblox Studio cua ban.")
end)

makeLabel("MENU")
makeButton("An / hien menu (RightShift)", function()
    window.Visible = not window.Visible
end)

UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        window.Visible = not window.Visible
    end
end)

